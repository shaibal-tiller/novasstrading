# Uploaded images and PDFs. Filenames are unique per upload and never rewritten
# in place, so browsers, the Vercel image optimizer and any CDN may keep them
# for a year without revalidating.
<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable"
  Header set X-Content-Type-Options "nosniff"
  Header unset Set-Cookie
</IfModule>

# Safety: this folder holds user-supplied files. Never execute anything in it.
<FilesMatch "\.(php[0-9]?|phtml|phar|pl|py|cgi|sh)$">
  Require all denied
</FilesMatch>
Options -Indexes -ExecCGI
