# ── Nova SS Trading — Environment Configuration ──
# For local development: copy to .env.local (Next.js reads this automatically)
#   cp .env.example .env.local
#
# For Vercel production: add each variable in
#   Vercel Dashboard → Project → Settings → Environment Variables

# Brevo transactional email API key
# Get from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your-brevo-api-key-here

# Destination email for admin notifications
CONTACT_EMAIL=info@novasstrading.com

# Branding (used in email templates)
SITE_NAME=Nova SS Trading
SITE_DOMAIN=novasstrading.com

# Inventory / Assets app (novass-inventory Vercel project) — mounted under
# /admin/inventory via Next.js Multi-Zones rewrites (see next.config.mjs). Its
# own *.vercel.app URL, never a custom domain.
# REQUIRED for the admin area: it is the identity store behind the shared
# sign-in door (/admin/login) — this app calls its /admin/inventory/api/auth/me
# to check the `nova_session` cookie. Unset = nobody can sign in to /admin
# (the public site still builds and runs; the rewrites just no-op).
INVENTORY_URL=https://novass-inventory.vercel.app

# Content portal — PHP API on Exonhost cPanel (see cpanel-api/DEPLOY.md)
CPANEL_API_URL=https://content-api.novasstrading.com
CPANEL_API_KEY=your-shared-api-key-here

# Media host — where uploaded images are served from (cPanel Media Library).
# Public because ContentMedia is a Client Component. Leave unset for local dev
# (bundled /assets images work without this).
NEXT_PUBLIC_MEDIA_BASE_URL=https://content-api.novasstrading.com


# Content API token signing — MUST be the exact same value as SESSION_SECRET
# on the PHP content API server (cpanel-api). After checking the shared admin
# session, the website editor mints a 5-minute bearer token for the content
# API with it. Required for the website editor to save anything.
CPANEL_SESSION_SECRET=same-value-as-the-php-SESSION_SECRET

# One-off, only for `npm run migrate:content` (seeds the DB from lib/content.ts).
# Paste a session token from a real admin login; remove it afterwards.
# MIGRATION_SESSION_TOKEN=

# ── Analytics — all optional. Unset = the public site loads no tracking at all
#    and /admin/analytics shows "Not connected yet". Guide: docs/analytics-setup.md
#
# GA4 measurement ID (starts with G-). Public: switches on the cookie banner and,
# only after a visitor clicks Accept, the Google Analytics tag. Production only;
# staging should use a separate test property (Vercel "Preview" environment).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google service account JSON key (the file's JSON, or base64 of it). SECRET —
# lets /admin/analytics read GA4 + Search Console, read-only.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Numeric GA4 property ID (GA4 Admin → Property details), e.g. 123456789 — not the G- ID.
GA4_PROPERTY_ID=
# Optional: only count GA4 traffic for this hostname, e.g. novasstrading.com.
GA4_HOSTNAME=
# Search Console property exactly as Google shows it: https://novasstrading.com/
# (URL-prefix property) or sc-domain:novasstrading.com (Domain property).
GSC_SITE_URL=
