# PRODUCTION backup - NOT installed yet. Use only after the production cutover, on the owner's word.
# Copy to ~/.nova-backup/production.conf on the server and fill in the real paths.
BACKUP_NAME=production

# Website editor database: its login comes from the production API's .env.php.
# Assets database: its login lives only in Vercel, so give the backup its own READ-ONLY MySQL user
# (cPanel -> MySQL Databases: new user, privileges SELECT, SHOW VIEW, LOCK TABLES, TRIGGER only)
# in a client option file with chmod 600:  [client] host=localhost user=... password="..."
DB_SOURCES=(
  "envphp:$HOME/<production api folder>/.env.php"
  "cnf:$HOME/.nova-backup/assets-readonly.cnf:novasst1_nova_assets"
)

FILE_PATHS=(
  "$HOME/<production api folder>/public/media"
  "$HOME/nova_secure_files"        # Assets photos/documents (already encrypted by the Assets app)
)

AGE_RECIPIENTS=("age14359yxnh8ckzs2zfur3dyyjerc9gt4ppxrqay9ln0g2txcw8jqzsv7q8ed")
DRIVE_REMOTE="gdrive:NovaSS-Backups/production"
GIT_REPO_DIR="$HOME/.nova-backup/git"
KEEP_WEEKLY=12
KEEP_MONTHLY=6
ALERT_EMAIL="it-support@novasstrading.com"
PHP_BIN=/opt/cpanel/ea-php81/root/usr/bin/php
